# ── AWS ──────────────────────────────────────────────────────
# Region for SES and S3
AWS_REGION=us-east-1

# AWS credentials (or use IAM role on EC2/ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for storing prototypes and shared assets
S3_BUCKET=

# ── Email (Amazon SES) ──────────────────────────────────────
# Sender address (must be SES-verified)
FROM_EMAIL=

# Email address that receives MDA submission notifications
MDA_EMAIL=

# ── Anthropic ───────────────────────────────────────────────
# API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Server ──────────────────────────────────────────────────
PORT=3000
